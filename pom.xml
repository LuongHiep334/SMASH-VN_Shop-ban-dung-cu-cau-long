<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/> </parent>
	<groupId>com.smashvn</groupId>
	<artifactId>SMASH-VN</artifactId>
	<version>0.0.4</version>
	<name>SMASH-VN</name>
	<description>Website ban dung cu cau long - Do an tot nghiep</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>
	<dependencies>
		<dependency>
		    <groupId>org.springframework.boot</groupId>
		    <artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
		    <groupId>org.mindrot</groupId>
		    <artifactId>jbcrypt</artifactId>
		    <version>0.4</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-client</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.microsoft.sqlserver</groupId>
			<artifactId>mssql-jdbc</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Isolated in-memory database for customer search regression tests. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Apache POI cho Excel -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi</artifactId>
			<version>5.2.5</version>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.2.5</version>
		</dependency>

		<!-- Flyway Migration -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-sqlserver</artifactId>
		</dependency>

		<!-- Caffeine Cache -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<!-- Apache Tika for MIME Validation -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>2.9.2</version>
		</dependency>

		<!-- Spring Boot Starter Validation -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Jsoup for HTML/XSS Sanitization -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.18.1</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>


	<!-- Isolated test selection. SQL Server integration and seed tools are excluded from this profile. -->
	<profiles>
		<profile>
			<id>verification</id>
			<build><plugins><plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<app.dotenv.enabled>false</app.dotenv.enabled>
					</systemPropertyVariables>
					<includes>
						<include>**/AddressResolutionServiceTest.java</include>
						<include>**/AddressRestControllerTest.java</include>
						<include>**/AdminNhanVienServiceTest.java</include>
						<include>**/AdminThongKePaymentStatusTest.java</include>
						<include>**/CategoryTypeTest.java</include>
						<include>**/CheckoutControllerTest.java</include>
						<include>**/CheckoutRetryTest.java</include>
						<include>**/CustomerPriceSummaryTest.java</include>
						<include>**/CustomerPriceTemplateTest.java</include>
						<include>**/CustomerSearchApiTest.java</include>
						<include>**/CustomerSearchJpaTest.java</include>
						<include>**/DanhMucServiceTest.java</include>
						<include>**/DynamicFilterBackendTest.java</include>
						<include>**/ForgotPasswordRateLimiterTest.java</include>
						<include>**/GhnAddressMatchingTest.java</include>
						<include>**/GhnFallbackUnitTest.java</include>
						<include>**/GhnRestControllerTest.java</include>
						<include>**/GioHangControllerTest.java</include>
						<include>**/GioHangServiceAvailabilityTest.java</include>
						<include>**/GlobalNotificationAdviceTest.java</include>
						<include>**/GlobalShopContactAdviceTest.java</include>
						<include>**/GuestCheckoutServiceEmailTemplateTest.java</include>
						<include>**/GuestCheckoutServicePasswordTest.java</include>
						<include>**/HomeControllerPerformanceTest.java</include>
						<include>**/InventoryLotServiceTest.java</include>
						<include>**/NewsletterServiceTest.java</include>
						<include>**/P0TemplateContractTest.java</include>
						<include>**/ProductAttributeDataContractTest.java</include>
						<include>**/ProductAvailabilityServiceTest.java</include>
						<include>**/ProfanityFilterTest.java</include>
						<include>**/RacketSpecUtilsTest.java</include>
						<include>**/RegisterRateLimiterTest.java</include>
						<include>**/SanPhamYeuThichControllerTest.java</include>
						<include>**/SepayIpnControllerTest.java</include>
						<include>**/SepayOrderPaymentServiceTest.java</include>
						<include>**/SepaySimulationControllerTest.java</include>
						<include>**/SepayTimeoutAndExpirationTest.java</include>
						<include>**/SigninTemplateVisibilityTest.java</include>
						<include>**/SignupTemplateVisibilityTest.java</include>
						<include>**/StartAllCheckoutTest.java</include>
						<include>**/SupportPageMvcTest.java</include>
						<include>**/TemporaryPasswordServiceTest.java</include>
						<include>**/UnifiedNotificationAssetTest.java</include>
						<include>**/UploadResourceMappingTest.java</include>
						<include>**/UserAddressServiceTest.java</include>
						<include>**/UserDangKyControllerTest.java</include>
						<include>**/UserDangKyServiceTest.java</include>
						<include>**/UserDangNhapControllerTest.java</include>
						<include>**/UserDangNhapServiceTest.java</include>
						<include>**/UserDashboardControllerTest.java</include>
						<include>**/UserDashboardServiceTest.java</include>
						<include>**/UserQuenMatKhauControllerTest.java</include>
						<include>**/UserQuenMatKhauServiceTest.java</include>
					</includes>
				</configuration>
			</plugin></plugins></build>
		</profile>
	</profiles>
</project>
