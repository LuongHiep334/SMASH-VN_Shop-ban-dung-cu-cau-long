# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU CHO SMASH VN SHOP
# Sao chép file này thành .env và điền các thông tin thực của bạn
# KHÔNG BAO GIỜ commit file .env thật lên Git!
# ==========================================

# ------------------------------------------
# Cấu hình Kết nối Cơ sở dữ liệu SQL Server
# ------------------------------------------
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=BadmintonShopDB1;encrypt=true;trustServerCertificate=true;

# ------------------------------------------
# Cấu hình Mail Service (Gmail SMTP)
# Hướng dẫn tạo App Password: https://myaccount.google.com/apppasswords
# ------------------------------------------
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ------------------------------------------
# Cấu hình Google OAuth2 Client
# Tạo tại: https://console.cloud.google.com/apis/credentials
# ------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cấu hình API Gemini
GEMINI_API_KEY=your_gemini_api_key

# Danh sách Email Admin nhận thông báo (phân tách bằng dấu phẩy)
APP_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ------------------------------------------
# Thư mục gốc lưu file tải lên, bên trong chứa product/, reviews/, ...
# Trên máy chủ nên dùng đường dẫn tuyệt đối; không thêm /product ở cuối.
# Ví dụ Windows: C:/uploads/
# Ví dụ Linux:   /var/www/smashvn/uploads/
# ------------------------------------------
APP_UPLOAD_PATH=uploads/

# ------------------------------------------
# Cấu hình Hibernate
# Cấu trúc bảng được kiểm tra bằng validate và cập nhật bằng Flyway.
# ------------------------------------------
SPRING_JPA_SHOW_SQL=true

# ------------------------------------------
# Cấu hình ZaloPay Payment Gateway
# Sandbox: https://sb-openapi.zalopay.vn
# Production: https://openapi.zalopay.vn
# Đăng ký tại: https://zalopay.vn/developer
# ------------------------------------------
ZALOPAY_APP_ID=your_zalopay_app_id
ZALOPAY_KEY1=your_zalopay_key1
ZALOPAY_KEY2=your_zalopay_key2
ZALOPAY_CREATE_ORDER_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_CALLBACK_URL=http://localhost:8080/api/payment/zalopay/callback
ZALOPAY_REDIRECT_URL=http://localhost:8080/user/my-order

# ------------------------------------------
# Cấu hình SePay Payment Gateway
# Đăng ký tại: https://sepay.vn
# ------------------------------------------
SEPAY_API_KEY=your_sepay_api_key
SEPAY_SECRET_KEY=your_sepay_secret_key
SEPAY_IPN_SECRET=your_sepay_ipn_secret
SEPAY_BASE_URL=https://api.sepay.vn
SEPAY_BANK_ACCOUNT=your_bank_account_number
SEPAY_BANK_NAME=your_bank_name
SEPAY_MEMO_PREFIX=your_memo_prefix
SEPAY_DEBUG=false
SEPAY_IP_VERIFICATION=false
SEPAY_IP_RANGES=172.236.138.20,172.233.83.68,171.244.35.2,151.158.108.68,151.158.109.79,103.255.238.139

# ------------------------------------------
# Cấu hình Giao Hàng Nhanh (GHN)
# Test (Sandbox): https://5sao.dev.ghn.vn
# Production:     https://online-gateway.ghn.vn
# Đăng ký tại: https://sso.ghn.vn
# ------------------------------------------
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=your_ghn_api_token
GHN_WEBHOOK_TOKEN=your_unique_ghn_webhook_secret
GHN_SHOP_ID=0
GHN_FROM_DISTRICT_ID=1454
GHN_FROM_WARD_CODE=21012
GHN_FROM_ADDRESS=Địa chỉ kho hàng của bạn

# URL công khai và cookie HTTPS khi triển khai
APP_BASE_URL=http://localhost:8080
SESSION_COOKIE_SECURE=false

# Tùy chọn định vị địa chỉ và đồng bộ giao hàng
MAPTILER_API_KEY=
GHN_POLLING_ENABLED=false

# Tùy chọn cho deploy.js; chỉ điền nếu dùng dịch vụ MCP hosting riêng
MCP_URL=
MCP_TOKEN=
